# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# turbo
.turbo

# production
build
dist

# misc
.DS_Store
*.pem

# editor / IDE (local only)
.cursor/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local scratch / temp exports
.tmp/
data/
scratch/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-video
apps/web/videos/*
!apps/web/videos/*.json
!apps/web/videos/*.js
!apps/web/videos/*.ts
apps/web/public/_next-video
videos/*
!videos/*.json
!videos/*.js
!videos/*.ts
public/_next-video

# Widget embed bundle — generated by @neylonai/sdk's build (build-embed.mjs)
# into this directory on every build (turbo `web...` builds the sdk first),
# so it never needs to be committed.
apps/web/public/v1/

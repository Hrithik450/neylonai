# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=your-super-secret-jwt-signing-key-min-32-chars

# Google OAuth (One-Tap Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-generative-ai-api-key
OPENAI_API_KEY=sk-...

# ─── Vector Database (ChromaDB Cloud) ─────────────────────────────────────────
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=your-chroma-database
CHROMA_COLLECTION_NAME=your-collection-name

# ─── Web Search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ─── Integrations ─────────────────────────────────────────────────────────────
# URL for the demo booking page (Calendly, Cal.com, etc.)
DEMO_BOOKING_URL=https://calendly.com/your-link

# Slack/Discord webhook for team notifications
TEAM_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret used to authenticate scheduled cron job requests
CRON_SECRET=your-cron-secret-key

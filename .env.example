# Canonical env for the whole monorepo (Next.js + db scripts + Docker).
# Copy to `.env` at the repo root — do not put env files under apps/web.
#
# Switching local Docker ↔ cloud Postgres/Redis = change the URLs below (and
# DATABASE_SSL), then run migrations. No code changes.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker Compose (app inside compose network):
# DATABASE_URL=postgresql://neylonai:neylonai@postgres:5432/neylonai
# DATABASE_SSL=false
#
# Local `pnpm dev` + `docker compose up postgres redis -d` (host port 5432):
# DATABASE_URL=postgresql://neylonai:neylonai@localhost:5432/neylonai
# DATABASE_SSL=false
#
# Supabase (recommended for Vercel serverless):
#   Dashboard → Connect → copy BOTH strings:
#   - Transaction pooler (:6543) → DATABASE_URL  (app / Vercel runtime)
#   - Direct (:5432)             → DATABASE_DIRECT_URL  (migrations / drizzle-kit)
#   Shared pooler host looks like: aws-0-<region>.pooler.supabase.com
#   Dedicated PgBouncer (paid):    db.<ref>.supabase.co:6543
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# DATABASE_SSL=true
#
# Other cloud (Neon / RDS) — enable the `vector` extension:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true
DATABASE_URL=postgresql://neylonai:neylonai@localhost:5432/neylonai
# DATABASE_DIRECT_URL=
DATABASE_SSL=false
# Optional: directories for org-uploaded widget fonts / logos
# Local / Docker only — do not rely on these on Vercel (ephemeral FS).
# NEYLONAI_ORG_FONTS_DIR=/var/lib/neylonai/org-fonts
# NEYLONAI_ORG_LOGOS_DIR=/var/lib/neylonai/org-logos
#
# Vercel Blob — required for font + logo uploads on Vercel (durable CDN URLs).
# Create a Blob store in the Vercel dashboard and paste the token:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…
# Optional pool tuning (defaults: max=1 on Vercel/transaction pooler, else 10)
# DATABASE_POOL_MAX=1

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local Docker Compose network:  redis://redis:6379
# Local host / pnpm dev:         redis://localhost:6379
# Cloud (Upstash etc.):          rediss://default:TOKEN@HOST:6379
REDIS_URL=redis://localhost:6379

# Website crawler worker (BullMQ). Run beside web: pnpm --filter crawler dev
# CRAWL_CONCURRENCY=1
# CRAWL_PAGE_CONCURRENCY=3

# ─── Auth ─────────────────────────────────────────────────────────────────────
# CRITICAL: Generate a secure random secret for production. Never use this example value.
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_THIS_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS

# Google OAuth (One-Tap Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── AI / LLM (Gemini) ────────────────────────────────────────────────────────
# Scalable key pool — add as many paid keys as you want (comma or whitespace).
# Round-robin load balances; on 429/quota the key cools down and the next is used.
GEMINI_API_KEYS=your-key-1,your-key-2,your-key-3,your-key-4,your-key-5
# Single-key shorthand (also accepted): GEMINI_API_KEY=...
# Or numbered (also merged into the pool):
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# Cooldown after rate-limit (ms); default 60000
GEMINI_API_KEY_COOLDOWN_MS=60000

# Embeddings: gemini-embedding-001 → 3072 dims (free tier). Must match stored vectors.
EMBEDDING_MODEL=gemini-embedding-001
# AI Studio limits used for integration batching. Requests target 70% TPM.
EMBEDDING_MODEL_TPM=30000
UTILITY_MODEL_TPM=250000
UTILITY_MODEL_OUTPUT_TOKENS=32000
GEMINI_BATCH_TPM_UTILIZATION=0.7
# Model router tiers (complexity → model). High/max big model is gemini-3.6-flash.
# Note: gemini-2.5-flash-lite is unavailable to new API users — use 3.1+ lite.
AGENT_MODEL_LOW=gemini-3.1-flash-lite
AGENT_MODEL_MEDIUM=gemini-3.5-flash-lite
AGENT_MODEL_HIGH=gemini-3.6-flash
# Fallback alias for high tier (used if AGENT_MODEL_HIGH unset)
AGENT_MODEL=gemini-3.6-flash
# Latency-first complexity classifier (heuristics skip this when possible)
ROUTER_CLASSIFIER_MODEL=gemini-3.1-flash-lite
# Waiting-screen tips: flash-lite refresh (heuristics always show instantly)
THINKING_TIPS_MODEL=gemini-3.1-flash-lite
THINKING_TIPS_TIMEOUT_MS=700
# Set to false to disable LLM tip refresh (heuristics only)
# THINKING_TIPS_LLM=false
# Utility LLM (query expansion, reframe, thread titles)
UTILITY_MODEL=gemini-3.1-flash-lite
# Widget mic speech-to-text (Gemini audio understanding; falls back to UTILITY_MODEL)
STT_MODEL=gemini-3.1-flash-lite

# ─── Site Configuration ───────────────────────────────────────────────────────
# Production site URL (required for SEO, Open Graph, sitemaps)
NEXT_PUBLIC_SITE_URL=https://neylonai.mhrithik.com

# ─── First-party landing widget ───────────────────────────────────────────────
# Same model as any customer embed: publishable client API key for **your** org.
# Create in Settings → Security. Landing SupportWidget loads that org’s published config.
# NEYLONAI_SITE_API_KEY=nk_live_…   # optional server-only override
# Local/dev: SDK uses the page origin automatically on localhost.
# Optional override: NEXT_PUBLIC_NEYLONAI_API_ORIGIN=http://localhost:3000

# Knowledge scope for **local/dev scripts only** (reembed, benchmarks).
# Production tenants come from API-key / session auth — never these slugs.
KNOWLEDGE_ORGANIZATION_SLUG=neylonai
KNOWLEDGE_BASE_SLUG=organization_data

# ─── Web Search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ─── Website scrape (JS-rendered pages) ───────────────────────────────────────
# Order used by website import + scrape_url tool: Firecrawl → Jina → static HTML.
# Firecrawl Free: 1,000 credits/mo (1 credit/page). https://www.firecrawl.dev/pricing
# FIRECRAWL_API_KEY=fc-...
# Optional COGS override (default Hobby effective ≈ $0.0032 / credit):
# FIRECRAWL_USD_PER_CREDIT=0.0032
#
# Jina Reader (default free fallback, no key required): https://r.jina.ai/
# Optional key for higher rate limits:
# JINA_API_KEY=jina_...

# ─── Integrations ─────────────────────────────────────────────────────────────
# Master key for encrypting customer integration credentials at rest
# (Postgres connection URLs, future OAuth tokens). 32 bytes as 64 hex chars:
#   openssl rand -hex 32
# CRITICAL: Required in production. Never commit the actual key to git.
# Local/dev falls back to a derivation of AUTH_SECRET.
# INTEGRATION_SECRETS_MASTER_KEY=
TEAM_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Cron ─────────────────────────────────────────────────────────────────────
# CRITICAL: Generate a secure random secret for production. Never use this example value.
# Generate with: openssl rand -base64 32
CRON_SECRET=REPLACE_THIS_WITH_SECURE_RANDOM_SECRET# Deployment trigger
